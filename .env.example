# Copy to .env for local dev. Never commit .env.
SECRET_KEY=replace-with-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# CORS — origins allowed to POST registrations
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://demo-bard-santner-golf-v3.onrender.com

# Google Sheets — either point at a JSON file OR set GOOGLE_SHEETS_CREDENTIALS_JSON
GOOGLE_SHEETS_CREDENTIALS=service_account.json
# GOOGLE_SHEETS_CREDENTIALS_JSON='{"type":"service_account",...}'
GOOGLE_SHEET_ID=your-google-sheet-id-here
KWEKWE_TAB_NAME=Kwekwe Registrations
